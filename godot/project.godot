[application]
config/name="BLACKOUT: SWEDEN"
run/main_scene="res://main.tscn"

[autoload]
CameraController="*res://camera_controller.gd"
MobileActionPad="*res://mobile_action_pad.gd"
IdleFishingRig="*res://idle_fishing_rig.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

audio/driver/enable_input=false
